{
  "name": "@nl4ever/sshmcp",
  "version": "0.1.1",
  "description": "MCP server for SSH remote management with file transfer and per-connection SOCKS5 proxy support",
  "keywords": [
    "mcp",
    "ssh",
    "sftp",
    "socks5",
    "proxy",
    "claude",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sshmcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "socks": "^2.8.3",
    "ssh2": "^1.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
